{
  "name": "model-ia-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Architecture spike for model-ia-testing",
  "type": "module",
  "scripts": {
    "lint": "eslint src scripts spike playwright.config.ts --max-warnings=0",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:bdd": "tsx scripts/test-bdd.ts",
    "test:browser": "playwright test",
    "evidence:viewer": "tsx src/infrastructure/evidence/serve-live-evidence.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "evaluation:semantic:live": "tsx scripts/run-live-semantic-evaluator.ts",
    "evaluation:report": "tsx scripts/render-evaluation-report.ts",
    "browser:sut": "tsx scripts/run-browser-sut.ts",
    "browser:discovery:run": "tsx scripts/run-public-sut-discovery.ts",
    "browser:discovery:adaptive": "tsx scripts/run-adaptive-discovery.ts",
    "browser:discovery:benchmark": "tsx scripts/run-discovery-benchmark.ts",
    "browser:discovery:stages": "tsx scripts/run-discovery-stages.ts",
    "browser:discovery:interaction": "tsx scripts/run-adaptive-interaction-benchmark.ts",
    "browser:three-model:benchmark": "tsx scripts/run-three-model-conversation-benchmark.ts",
    "browser:discovery:merge": "tsx scripts/merge-discovery-reports.ts",
    "test:architecture": "npm run lint && npm run build && npm test && npm run test:bdd && npm run test:browser"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "~10.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
